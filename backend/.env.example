# Supabase configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Note: Use the service_role key on the backend to bypass RLS policies for server operations
SUPABASE_KEY=your-supabase-service-role-key

# Server configuration
PORT=8000

# CORS origins: comma-separated list of allowed origins. Use '*' to allow all.
ALLOWED_ORIGINS=http://localhost:5173,https://yourusername.github.io
